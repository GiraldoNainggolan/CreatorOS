# TCOS Monorepo Environment Template
# Note: Never commit sensitive keys (secret key, service role key) to version control.

# Frontend (Supabase Auth - Client Safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Frontend API Base URL
VITE_API_BASE_URL=/api

# Backend (Laravel)
APP_NAME=TCOS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
