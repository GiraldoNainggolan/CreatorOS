# TCOS Frontend Environment Variables
# Note: Never commit sensitive keys (secret key, service role key) to version control.

# Supabase Auth Configuration (Client Safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional API Backend (Local development with Laravel / Laragon)
VITE_API_BASE_URL=/api
